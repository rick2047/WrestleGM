Screen {
    align: center middle;
}

.panel {
    width: 40;
    height: auto;
    padding: 1 2;
    border: solid gray;
}

.section-title {
    text-style: bold;
    margin-bottom: 1;
}

Button {
    width: 18;
}

ListView {
    height: auto;
}

.spacer {
    height: 1;
}

.booking-shell {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.booking-card {
    border: solid gray;
    padding: 1 2;
    width: 1fr;
    height: 1fr;
}

.match-booking-header {
    text-style: bold;
    margin-bottom: 1;
}

.match-booking-controls {
    height: auto;
    min-height: 6;
    margin-bottom: 1;
    align: left middle;
}

.match-booking-controls-row {
    height: 3;
    min-height: 3;
    layout: grid;
    grid-size: 4 1;
    grid-columns: 12 8 6 18;
    grid-rows: 1;
    grid-gutter: 1;
    align: left middle;
}

.inline-label {
    width: auto;
}

#match-category {
    width: 8;
}

#match-type {
    width: 18;
}

.match-booking-controls Select {
    border: round gray;
    display: block;
    height: 3;
    min-height: 3;
    min-width: 8;
    padding: 0 1;
    content-align: center middle;
}


.match-wrestlers-scroll {
    height: 1fr;
}

.booking-actions {
    height: auto;
    margin-top: 1;
}

.booking-screen {
    align: left top;
}

.booking-section-title {
    text-style: bold;
    margin-bottom: 1;
}

.wrestler-view {
    border: solid gray;
    padding: 1 2;
    margin-bottom: 1;
}

.wrestler-name-header {
    text-style: bold;
    margin-bottom: 1;
}

.wrestler-empty-label {
    text-style: bold;
    margin-bottom: 1;
}

.wrestler-avatar-frame {
    height: 24;
    width: 48;
    margin-bottom: 1;
}

.wrestler-avatar {
    height: 24;
    width: 48;
}

.wrestler-stats {
    margin-bottom: 1;
}

.wrestler-description {
    margin-bottom: 1;
}

.wrestler-rivalry-title {
    text-style: bold;
    margin-bottom: 1;
}

.wrestler-rivalry-scroll {
    height: 5;
}

.guard-message {
    text-align: center;
}

.inspect-panel {
    width: 60;
}

.modal-hint {
    text-align: center;
    margin-top: 1;
}
